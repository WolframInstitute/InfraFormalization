/-
Multiway systems: the relation generated by all possible rule firings.

Following JGORARD §2.2 (arXiv:2004.14810), an abstract rewriting system
is a type with a binary relation. The multiway relation for a
hypergraph rewriting system is: `s →₁ s'` iff there exists a rule `r`
in the system and an application `a : Application r s` such that
`a.result = s'`.

Confluence / causal-invariance / Church-Rosser are then the standard
rewrite-theory properties of this relation.
-/

import InfraFormalization.Application
import Mathlib.Logic.Relation

namespace InfraFormalization

/-- A rewriting system is a (finite) list of rules on a shared pattern-
vertex type `P`. -/
structure RewritingSystem (P : Type*) where
  rules : List (Rule P)

variable {P V : Type*} [DecidableEq V]

/-- One-step rewriting relation induced by a system. -/
inductive Step (sys : RewritingSystem P) :
    Hypergraph V → Hypergraph V → Prop
  | apply (s : Hypergraph V) (r : Rule P) (_hr : r ∈ sys.rules)
      (a : Application r s) : Step sys s a.result

/-- Reflexive-transitive closure of `Step`. -/
def MultiStep (sys : RewritingSystem P) :
    Hypergraph V → Hypergraph V → Prop :=
  Relation.ReflTransGen (Step sys)

/-- Confluence (Def 7, arXiv:2004.14810): every divergent pair reconverges. -/
def Confluent (sys : RewritingSystem P) : Prop :=
  ∀ a b c : Hypergraph V,
    MultiStep sys a b → MultiStep sys a c →
    ∃ d, MultiStep sys b d ∧ MultiStep sys c d

/-- Local confluence (Eq 9). -/
def LocallyConfluent (sys : RewritingSystem P) : Prop :=
  ∀ a b c : Hypergraph V,
    Step sys a b → Step sys a c →
    ∃ d, MultiStep sys b d ∧ MultiStep sys c d

end InfraFormalization
