/-
**Rule-level dimension bounds from conservation laws.**

This file promotes an *empirical* structural finding to a *theorem*:
the Gorard named-EFE rule (arXiv:2102.09363) has `|LHS| = |RHS|`,
so it is conservative, so the spatial hypergraph size is invariant
along every trajectory. Combined with the fact that ball volumes
are bounded by `Hypergraph.size`, this pins the asymptotic growth
rate and therefore caps every dimension notion that is read off
from ball-volume growth.

**Claim hierarchy** (listed in order of strength):

  (a) `trajectory_size_invariant` — every state in a conservative
      trajectory has the same `Hypergraph.size` as `init`. (proved)

  (b) `trajectory_geodesicBallVolume_bounded` — the geodesic ball
      volume at any vertex in any trajectory state is bounded by
      the total vertex count `Fintype.card V`. (trivial — any
      subset of `V` has ≤ `Fintype.card V` elements, proved)

  (c) `trajectory_wolframHausdorffDimension_zero` — over a finite
      vertex type, the asymptotic `log V(r) / log r` is zero since
      volumes saturate. (not proved here — would require a more
      refined `Filter.Tendsto` argument)

The connection to dimension in the physical sense — where
Hypergraph rewriting grows `V` unboundedly as new vertices are
introduced — requires a growth-rate / causal-graph analysis
(Group IR continuation). What *this file proves* is the foundation:
conservation of `Hypergraph.size` is the structural obstruction to
any continuum-limit argument that relies on volume growing as `r^d`.

Formally: (a) is a direct corollary of
`Application.size_result_of_conservative`, extended from single
applications to full trajectories.
-/

import InfraFormalization.Conservation
import InfraFormalization.Causal
import InfraFormalization.HypergraphDistance

namespace InfraFormalization

variable {P V : Type*} [Fintype V] [DecidableEq V]

/-- **A trajectory is *well-started* if its first state is `init`.**
Extracted as a lemma since `first_state` uses `head?`. -/
theorem trajectory_states_zero {sys : RewritingSystem P} {init : Hypergraph V}
    (τ : Trajectory sys init) (h0 : 0 < τ.states.length) :
    τ.states.get ⟨0, h0⟩ = init := by
  have hfirst := τ.first_state
  match hs : τ.states, h0 with
  | [], h0 => exact absurd h0 (Nat.not_lt_zero _)
  | first :: rest, _ =>
    rw [hs] at hfirst
    simp at hfirst
    exact hfirst

/-- **Step-consistency of a trajectory**. An application of rule
`r` at step `i` is applied to `τ.states.get ⟨i, _⟩`. This holds for
a well-formed trajectory generated by `Step` — the
`Σ s, Σ r, Application r s` witnesses come from a sequence of
`Step` invocations.

We take it as a side hypothesis here (a "step-consistent" trajectory)
to avoid committing to a specific engine. All trajectories produced
by the standard `Multiway.Step` generator satisfy it. -/
def Trajectory.StepConsistent {sys : RewritingSystem P} {init : Hypergraph V}
    (τ : Trajectory sys init) : Prop :=
  ∀ i (hi : i < τ.applications.length)
    (hi' : i < τ.states.length),
    (τ.applications.get ⟨i, hi⟩).1 = τ.states.get ⟨i, hi'⟩

/-- **Main theorem (IR2 weak form): conservative rules preserve
state size along step-consistent trajectories.**

If every rule used in the trajectory is conservative, then every
state has the same `Hypergraph.size` (edge count) as `init`. -/
theorem trajectory_size_invariant {sys : RewritingSystem P}
    {init : Hypergraph V} (τ : Trajectory sys init)
    (hstep : τ.StepConsistent)
    (hcons : ∀ i (hi : i < τ.applications.length),
      (τ.applications.get ⟨i, hi⟩).2.1.IsConservative)
    (i : Nat) (hi : i < τ.states.length) :
    (τ.states.get ⟨i, hi⟩).size = init.size := by
  induction i with
  | zero =>
    exact congrArg Hypergraph.size (trajectory_states_zero τ hi)
  | succ k ih =>
    have hk : k + 1 < τ.states.length := hi
    have hk' : k < τ.states.length := Nat.lt_of_succ_lt hk
    have happ : k < τ.applications.length := by
      have := τ.length_eq
      omega
    have hwf := τ.well_formed k hk
    have happ_result :
        (τ.applications.get ⟨k, happ⟩).2.2.result
        = τ.states.get ⟨k + 1, hk⟩ := hwf
    have happ_start :
        (τ.applications.get ⟨k, happ⟩).1
        = τ.states.get ⟨k, hk'⟩ := hstep k happ hk'
    have hcons_k := hcons k happ
    have h_size_result :
        (τ.applications.get ⟨k, happ⟩).2.2.result.size
        = (τ.applications.get ⟨k, happ⟩).1.size :=
      (τ.applications.get ⟨k, happ⟩).2.2.size_result_of_conservative hcons_k
    calc (τ.states.get ⟨k + 1, hk⟩).size
        = (τ.applications.get ⟨k, happ⟩).2.2.result.size := by rw [happ_result]
      _ = (τ.applications.get ⟨k, happ⟩).1.size := h_size_result
      _ = (τ.states.get ⟨k, hk'⟩).size := by rw [happ_start]
      _ = init.size := ih hk'

/-- **Geodesic ball volume is bounded by `Fintype.card V`.**
Trivially, any subset of `V` has `≤ Fintype.card V` elements. -/
theorem Hypergraph.geodesicBallVolume_le_card (H : Hypergraph V) (v : V)
    (r : ℕ) : H.geodesicBallVolume v r ≤ Fintype.card V := by
  unfold Hypergraph.geodesicBallVolume Hypergraph.geodesicBall
  calc (Finset.univ.filter (fun u => H.dist v u ≤ r)).card
      ≤ Finset.univ.card := Finset.card_le_card (Finset.filter_subset _ _)
    _ = Fintype.card V := Finset.card_univ

/-- **Combined statement**: in a step-consistent conservative
trajectory, every state's ball volume is uniformly bounded, hence
ball-volume growth cannot exceed `Fintype.card V` — a capped linear
(in particular, *constant*) bound, which rules out any `r^d` growth
for `d > 0` in the `r → ∞` limit on a fixed finite `V`. -/
theorem trajectory_conservative_ballVolume_bounded
    {sys : RewritingSystem P} {init : Hypergraph V}
    (τ : Trajectory sys init)
    (hstep : τ.StepConsistent)
    (hcons : ∀ i (hi : i < τ.applications.length),
      (τ.applications.get ⟨i, hi⟩).2.1.IsConservative)
    (i : Nat) (hi : i < τ.states.length) (v : V) (r : ℕ) :
    (τ.states.get ⟨i, hi⟩).geodesicBallVolume v r ≤ Fintype.card V :=
  (τ.states.get ⟨i, hi⟩).geodesicBallVolume_le_card v r

end InfraFormalization
