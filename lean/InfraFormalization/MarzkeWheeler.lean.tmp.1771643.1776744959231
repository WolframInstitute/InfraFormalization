/-
**Marzke-Wheeler clock** on a causal graph (Group IC / #132).

The Marzke-Wheeler (1964) construction builds an operational clock
from two observer worldlines and light-ray bounces between them:
given observer A and a reference observer B at rest, light rays
bouncing between them mark unit ticks of proper time on A's chain,
and the ratio of tick-counts gives time dilation.

In the discrete setting:

  * Two `ObserverChain`s in a `CausalGraph V` are given.
  * A "light bounce" is a pair `(u ∈ A, v ∈ B)` with a degenerate
    causal interval.
  * Successive bounces along A define `MWTicks A B : Nat`.
  * Dilation factor between the two chains is
    `MWTicks A B / MWTicks B A`.

**Connection to hypergraphs.** Causal graphs come from
`Trajectory`s. Light rays are discrete null steps on the causal
graph. Ratio of tick-counts on different observer chains is
what defines operational time in the discrete infracausal setting.
-/

import InfraFormalization.CausalGraphType

namespace InfraFormalization
namespace CausalGraph

variable {V : Type*} [Fintype V] [DecidableEq V]
variable (G : CausalGraph V)

/-- **Light-bounce** between two observers: events `u` in observer
A and `v` in observer B related by a degenerate causal interval. -/
def LightBounce (u v : V) : Prop :=
  G.DegenerateInterval u v ∨ G.DegenerateInterval v u

/-- **Symmetry of LightBounce.** -/
theorem LightBounce.symm {u v : V} (h : G.LightBounce u v) :
    G.LightBounce v u := by
  cases h with
  | inl h => exact Or.inr h
  | inr h => exact Or.inl h

/-- **An MW clock between two observers A, B**: a finite sequence
of alternating bounces `A → B → A → B → ...`. Represented as a
list of `(V × V)` pairs: `(a_i, b_i)`. -/
structure MWClockConfig (G : CausalGraph V) where
  observerA : Finset V
  observerB : Finset V
  bounces   : List (V × V)
  allBouncesValid : ∀ p ∈ bounces,
    p.1 ∈ observerA ∧ p.2 ∈ observerB ∧ G.LightBounce p.1 p.2

/-- **Number of MW ticks** for an observer: the count of bounces
involving that observer. For symmetric setups (light bounces count
twice per tick cycle), this equals `bounces.length / 2`. -/
def MWTicks (cfg : MWClockConfig G) : Nat := cfg.bounces.length

/-- **Operational time dilation** between two observer chains in a
shared MW clock configuration: the ratio of tick-counts.
Discrete-side version of the Lorentz time-dilation factor. -/
noncomputable def timeDilation (cfg₁ cfg₂ : MWClockConfig G) : ℚ :=
  if h : MWTicks G cfg₂ = 0 then 0
  else (MWTicks G cfg₁ : ℚ) / (MWTicks G cfg₂ : ℚ)

/-- **Trivial case: identical clocks have dilation 1**. -/
theorem timeDilation_self (cfg : MWClockConfig G) (h : 0 < MWTicks G cfg) :
    timeDilation G cfg cfg = 1 := by
  unfold timeDilation
  rw [dif_neg (Nat.pos_iff_ne_zero.mp h)]
  rw [div_self]
  · rfl
  · exact_mod_cast (Nat.pos_iff_ne_zero.mp h)

end CausalGraph
end InfraFormalization
